generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("MYSQL_URL")
}

model User {
  id        String   @id @unique @default(uuid())
  name      String
  password  String
  email     String   @unique
  role      UserRole  @default(ESTUDIANTE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ESTUDIANTE
  DOCENTE
  ADMIN
}